# Service
METADATA_URL=http://localhost:3000
INDEXER_SERVICE_URL=http://localhost:3001
PORT=3000

# Google Cloud Storage (required)
GCLOUD_PROJECT_ID=
GCLOUD_BUCKET_NAME=avatars.namespace.ninja
GCLOUD_BUCKET_CLIENT_EMAIL=
GCLOUD_BUCKET_PRIVATE_KEY_ID=
# Base64-encoded PEM value, without line breaks.
GCLOUD_BUCKET_PRIVATE_KEY=

# Ethereum (Alchemy is required for SIWE smart-wallet verification)
ALCHEMY_API_KEY=
# Optional custom RPC endpoints for ENS ownership lookups.
ETH_MAINNET_RPC_URL=
ETH_SEPOLIA_RPC_URL=
# Optional Sepolia-only V2 authorization. Set helper and V1 mirror together.
# Leave empty to retain the existing address-based behavior. See README for
# verified public deployment addresses and the optional PublicResolverV2 adapter.
ENS_SEPOLIA_UNIVERSAL_HELPER=
ENS_SEPOLIA_V1_RESOLVER=
ENS_SEPOLIA_PUBLIC_RESOLVER_V2=

# Sign-In with Ethereum
SIWE_NONCE_TTL_MS=300000
SIWE_ALLOWED_CHAIN_IDS=1,11155111

# Upload size limits, in bytes (defaults: 2 MiB avatar, 5 MiB header)
MAX_AVATAR_BYTES_IN_MB=2097152
MAX_HEADER_BYTES_IN_MB=5242880
