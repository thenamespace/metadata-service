# Metadata Service Configuration
METADATA_URL=http://localhost:3000
INDEXER_SERVICE_URL=http://localhost:3001

# Server Configuration
PORT=3000

# Storage Configuration

STORAGE_MODE= # gcs / local

# Google Cloud Storage (when STORAGE_MODE=gcs)
GCLOUD_PROJECT_ID=
GCLOUD_BUCKET_NAME=
GCLOUD_BUCKET_CLIENT_EMAIL=
GCLOUD_SCOPES=
GCLOUD_BUCKET_PRIVATE_KEY=

# Ethereum RPC (optional, for ENS resolution)
ALCHEMY_API_KEY=

# Avatar file size
MAX_AVATAR_BYTES_IN_MB= #default to 5MB
MAX_HEADER_BYTES_IN_MB= #default to 5MB

# Sign in with Ethereum config
SIWE_NONCE_TTL_MS= #default to 5 * 60 * 1000 ~ 5 minutes
SIWE_ALLOWED_CHAIN_IDS= # defaults to 1,11155111 (Ethereum mainnet, Sepolia)
