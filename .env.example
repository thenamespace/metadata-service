# ─── Service ─────────────────────────────────────────────────────────────────

# Public URL of this service, used in metadata responses.
METADATA_URL=https://avtr.cc

# URL of the indexer/subname service consumed by the metadata module.
INDEXER_SERVICE_URL=http://localhost:3001

# HTTP port the service listens on. Default: 3000.
PORT=3000

# ─── Alchemy ─────────────────────────────────────────────────────────────────

# Required for SIWE smart-account verification and ENS resolution.
ALCHEMY_API_KEY=

# ─── SIWE Authentication ─────────────────────────────────────────────────────

# Comma-separated EIP-155 chain IDs accepted by SIWE verify. Default: mainnet + sepolia.
SIWE_ALLOWED_CHAIN_IDS=1,11155111

# Nonce TTL on the in-memory store, in ms. Default: 5 minutes.
SIWE_NONCE_TTL_MS=300000

# Strict-domain switch. Leave unset (or "false") during the 1-week grace period
# after deploy; flip to "true" once the avatar SDK + ui-kit are sending domain.
SIWE_DOMAIN_REQUIRED=false

# ─── Upload Limits ───────────────────────────────────────────────────────────

# Maximum avatar file size in bytes. Default: 2 MB (2097152).
# Note: despite the "MB" suffix in the var name, the value is in bytes.
MAX_AVATAR_BYTES_IN_MB=2097152

# Maximum header/banner file size in bytes. Default: 5 MB (5242880).
# Note: despite the "MB" suffix in the var name, the value is in bytes.
MAX_HEADER_BYTES_IN_MB=5242880

# ─── Google Cloud Storage ────────────────────────────────────────────────────

# GCS bucket name for avatar/header storage. Default: avatars.namespace.ninja.
GCLOUD_BUCKET_NAME=

# GCP project ID that owns the bucket.
GCLOUD_PROJECT_ID=

# Service account email with write access to the bucket.
GCLOUD_BUCKET_CLIENT_EMAIL=

# Base64-encoded RSA private key for the service account (single line, no newlines).
# Encode with: base64 -w0 private_key.pem  (Linux) or base64 -i private_key.pem (macOS)
GCLOUD_BUCKET_PRIVATE_KEY=

# Private key ID from the service account JSON ("private_key_id" field).
GCLOUD_BUCKET_PRIVATE_KEY_ID=
